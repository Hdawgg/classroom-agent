# Copy to .env and fill in. Only one LLM key is needed (checked in this order: NVIDIA, Groq, OpenAI).
# With no key at all, agent.py runs a scripted offline demo for Lab 04.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_API_KEY=

# Shown in the post-lab report header (left blank in the report if empty)
FACULTY=
STUDENT_NAME=
ROLL_NO=
BATCH=

# Study mode (optional): max characters of course text per LLM call; longer items are split into chunks
# STUDY_CHUNK_CHARS=20000
